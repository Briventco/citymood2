{
  "$description": "CityMood design tokens, Direction 1 (Window to Badagry). Mirrors tokens.css.",
  "color": {
    "lime": { "value": "#9AFF01", "use": "Fills, markers, rules, text on black only. Never text on white (1.26:1)." },
    "black": { "value": "#000000" },
    "white": { "value": "#FFFFFF" },
    "paper": { "value": "#F3F3EF" },
    "rule": { "value": "#D9D9D4" },
    "ruleDark": { "value": "#333330" },
    "meta": { "value": "#5C5C58", "contrastOnWhite": 6.72 },
    "metaOnDark": { "value": "#B8B8B2", "contrastOnBlack": 10.54 },
    "inkSoft": { "value": "#222222" },
    "adBorder": { "value": "#8A8A84" }
  },
  "font": {
    "serif": { "family": "Source Serif 4", "weights": [500, 600, 700], "use": "Headlines" },
    "sans": { "family": "Source Sans 3", "weights": [400, 600, 700, 800], "italic": [300], "use": "UI, body, metadata, tagline" },
    "subsets": ["latin", "latin-ext"],
    "note": "latin-ext is required for Yoruba (e.g. Àgbádárìgì, Ọjà, Ẹ̀kọ́)."
  },
  "typeScale": {
    "lead":       { "mobile": "30/1.08", "desktop": "50/1.05", "font": "serif", "weight": 700 },
    "feature":    { "mobile": "26/1.1",  "desktop": "40/1.08", "font": "serif", "weight": 700 },
    "band":       { "mobile": "30/1",    "desktop": "44/1",    "font": "serif", "weight": 700 },
    "cardLarge":  { "mobile": "24/1.12", "desktop": "30/1.1",  "font": "serif", "weight": 700 },
    "card":       { "mobile": "19/1.2",  "desktop": "22/1.2",  "font": "serif", "weight": 700 },
    "listItem":   { "mobile": "18/1.25", "desktop": "19/1.25", "font": "serif", "weight": 600 },
    "standfirst": { "mobile": "17/1.5",  "desktop": "20/1.5",  "font": "sans",  "weight": 400 },
    "summary":    { "mobile": "16/1.45", "desktop": "17/1.45", "font": "sans",  "weight": 400 },
    "section":    { "mobile": "19",      "desktop": "22",      "font": "sans",  "weight": 800, "transform": "uppercase" },
    "kicker":     { "mobile": "13",      "desktop": "14",      "font": "sans",  "weight": 800, "transform": "uppercase", "tracking": "0.1em" },
    "meta":       { "mobile": "13",      "desktop": "14",      "font": "sans",  "weight": 400 },
    "nav":        { "mobile": "15",      "desktop": "16",      "font": "sans",  "weight": 700 },
    "label":      { "all": "11",         "font": "sans", "weight": 800, "transform": "uppercase", "tracking": "0.14em" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48, "14": 56 },
  "layout": { "container": 1240, "gutterMobile": 16, "gutterTabletUp": 24, "tapTarget": 44 },
  "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
  "radius": 0
}
